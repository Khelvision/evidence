{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:khelsutra:evidence:schema:v1:CommercializationReadinessV1",
  "title": "CommercializationReadinessV1",
  "type": "object",
  "required": ["schema_name", "schema_version", "record_id", "components"],
  "properties": {
    "schema_name": { "const": "CommercializationReadinessV1" },
    "schema_version": { "const": "1.0.0" },
    "record_id": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/recordId" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["category", "subject", "status"],
        "properties": {
          "category": {
            "enum": [
              "application_code",
              "base_model",
              "checkpoint",
              "training_data",
              "evaluation_data",
              "media",
              "hosted_api",
              "codec",
              "output_redistribution"
            ]
          },
          "subject": { "type": "string", "minLength": 1, "maxLength": 240 },
          "status": { "enum": ["verified_clear", "restricted", "unknown", "not_applicable"] },
          "evidence_refs": {
            "type": "array",
            "items": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/artifactRef" }
          },
          "limitations": { "type": "array", "items": { "type": "string", "maxLength": 500 } }
        },
        "additionalProperties": false
      }
    },
    "overall_status": { "enum": ["verified_clear", "restricted", "unknown"] },
    "reviewed_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
