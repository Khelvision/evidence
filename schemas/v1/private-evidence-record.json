{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:khelsutra:evidence:schema:v1:PrivateEvidenceRecordV1",
  "title": "PrivateEvidenceRecordV1",
  "description": "A producer-held superset that carries exactly one public evidence document, the private material that must never be projected, and the media authority that permits publication.",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "record_id",
    "producer",
    "public",
    "private_extensions",
    "media_authorizations",
    "projection"
  ],
  "properties": {
    "schema_name": { "const": "PrivateEvidenceRecordV1" },
    "schema_version": { "const": "1.0.0" },
    "record_id": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/recordId" },
    "producer": {
      "type": "object",
      "required": ["repository", "revision"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "maxLength": 160 },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "receipt_id": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/recordId" }
      },
      "additionalProperties": false
    },
    "public": {
      "type": "object",
      "required": ["schema_name"],
      "properties": {
        "schema_name": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "private_extensions": { "type": "object" },
    "media_authorizations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "publication_grant",
          "consent_ref",
          "custody",
          "purpose_grants"
        ],
        "properties": {
          "artifact_id": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/recordId" },
          "publication_grant": {
            "enum": ["verified_clear", "restricted", "unknown", "not_applicable"]
          },
          "consent_ref": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/artifactRef" },
          "guardian_authorization_ref": {
            "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/artifactRef"
          },
          "custody": { "enum": ["owner_controlled", "producer_controlled", "third_party"] },
          "purpose_grants": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/purposeGrant" }
          }
        },
        "additionalProperties": false
      }
    },
    "projection": {
      "type": "object",
      "required": ["public_record_digest"],
      "properties": {
        "public_record_digest": {
          "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/digest"
        },
        "projected_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
