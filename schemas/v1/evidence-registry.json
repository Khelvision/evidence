{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:khelsutra:evidence:schema:v1:EvidenceRegistryV1",
  "title": "EvidenceRegistryV1",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "record_id",
    "registry",
    "releases"
  ],
  "properties": {
    "schema_name": { "const": "EvidenceRegistryV1" },
    "schema_version": { "const": "1.0.0" },
    "record_id": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/recordId" },
    "registry": { "enum": ["official", "community"] },
    "releases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/artifactRef" }
    }
  },
  "additionalProperties": false
}
