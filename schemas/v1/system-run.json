{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:khelsutra:evidence:schema:v1:SystemRunV1",
  "title": "SystemRunV1",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "record_id",
    "run_id",
    "run_class",
    "system",
    "task_contract",
    "samples",
    "scenario_strata",
    "metrics",
    "timings",
    "failures_included"
  ],
  "properties": {
    "schema_name": { "const": "SystemRunV1" },
    "schema_version": { "const": "1.0.0" },
    "record_id": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/recordId" },
    "run_id": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/recordId" },
    "run_class": { "enum": ["official", "community", "synthetic"] },
    "system": {
      "type": "object",
      "required": ["name", "version", "digest"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "version": { "type": "string", "minLength": 1, "maxLength": 120 },
        "digest": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "task_profile_ref": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/artifactRef" },
    "task_contract": {
      "type": "object",
      "required": ["task_id", "prediction_unit", "scorer_name", "scorer_version"],
      "properties": {
        "task_id": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/recordId" },
        "prediction_unit": {
          "enum": ["rally_boundary", "rally_outcome", "shot_boundary", "coach_instruction"]
        },
        "boundary_tolerance_frames": { "type": "integer", "minimum": 0 },
        "scorer_name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "scorer_version": { "type": "string", "minLength": 1, "maxLength": 80 }
      },
      "additionalProperties": false
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sample_id", "status"],
        "properties": {
          "sample_id": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/recordId" },
          "status": { "enum": ["accepted", "rejected", "failed", "excluded"] },
          "prediction_ref": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/artifactRef" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
          "manual_correction_minutes": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "scenario_strata": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "scenario_profile_refs": {
      "type": "array",
      "items": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/artifactRef" }
    },
    "metrics": {
      "type": "array",
      "items": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/qualityMetric" }
    },
    "timings": {
      "type": "array",
      "items": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/phaseTiming" }
    },
    "cost_receipt": { "$ref": "urn:khelsutra:evidence:schema:v1:CostReceiptV1" },
    "commercialization_ref": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/artifactRef" },
    "failures_included": { "type": "boolean" },
    "notes": { "type": "string", "maxLength": 3000 }
  },
  "additionalProperties": false
}
