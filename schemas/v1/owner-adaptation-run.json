{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:khelsutra:evidence:schema:v1:OwnerAdaptationRunV1",
  "title": "OwnerAdaptationRunV1",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "record_id",
    "adaptation_id",
    "workspace_id",
    "base_package_id",
    "candidate_package_id",
    "training_sample_ids",
    "heldout_sample_ids",
    "distinct_training_sessions",
    "annotation_minutes",
    "training_wall_seconds",
    "training_cost_usd",
    "owner_metric_before",
    "owner_metric_after",
    "common_ruler_delta",
    "overlap_check_passed",
    "decision"
  ],
  "properties": {
    "schema_name": { "const": "OwnerAdaptationRunV1" },
    "schema_version": { "const": "1.0.0" },
    "record_id": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/recordId" },
    "adaptation_id": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/recordId" },
    "workspace_id": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/recordId" },
    "base_package_id": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/recordId" },
    "candidate_package_id": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/recordId" },
    "training_sample_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/recordId" }
    },
    "heldout_sample_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/recordId" }
    },
    "distinct_training_sessions": { "type": "integer", "minimum": 1 },
    "approved_examples": { "type": "integer", "minimum": 1 },
    "annotation_minutes": { "type": "number", "minimum": 0 },
    "training_wall_seconds": { "type": "number", "minimum": 0 },
    "training_cost_usd": { "type": "number", "minimum": 0 },
    "owner_metric_before": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/qualityMetric" },
    "owner_metric_after": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/qualityMetric" },
    "common_ruler_delta": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/qualityMetric" },
    "correction_minutes_per_source_hour_before": { "type": "number", "minimum": 0 },
    "correction_minutes_per_source_hour_after": { "type": "number", "minimum": 0 },
    "overlap_check_passed": { "const": true },
    "decision": { "enum": ["pending", "promoted", "rejected"] },
    "decision_authority": { "enum": ["owner", "coach"] },
    "notes": { "type": "string", "maxLength": 3000 }
  },
  "additionalProperties": false
}
