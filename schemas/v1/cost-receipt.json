{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:khelsutra:evidence:schema:v1:CostReceiptV1",
  "title": "CostReceiptV1",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "record_id",
    "currency",
    "source_seconds",
    "accepted_source_seconds",
    "inference_usd",
    "accelerator_seconds",
    "wall_seconds",
    "retry_usd",
    "manual_review_minutes",
    "total_cost_usd",
    "inference_usd_per_source_hour",
    "accelerator_seconds_per_source_hour",
    "wall_seconds_per_source_hour",
    "total_cost_usd_per_accepted_source_hour"
  ],
  "properties": {
    "schema_name": { "const": "CostReceiptV1" },
    "schema_version": { "const": "1.0.0" },
    "record_id": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/recordId" },
    "currency": { "const": "USD" },
    "source_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "accepted_source_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "inference_usd": { "type": "number", "minimum": 0 },
    "accelerator_seconds": { "type": "number", "minimum": 0 },
    "wall_seconds": { "type": "number", "minimum": 0 },
    "retry_usd": { "type": "number", "minimum": 0 },
    "manual_review_minutes": { "type": "number", "minimum": 0 },
    "total_cost_usd": { "type": "number", "minimum": 0 },
    "inference_usd_per_source_hour": { "type": "number", "minimum": 0 },
    "accelerator_seconds_per_source_hour": { "type": "number", "minimum": 0 },
    "wall_seconds_per_source_hour": { "type": "number", "minimum": 0 },
    "manual_minutes_per_source_hour": { "type": "number", "minimum": 0 },
    "total_cost_usd_per_accepted_source_hour": { "type": "number", "minimum": 0 },
    "provider_rate_usd_per_hour": { "type": "number", "minimum": 0 },
    "notes": { "type": "string", "maxLength": 2000 }
  },
  "additionalProperties": false
}
