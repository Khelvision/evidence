{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:khelsutra:evidence:schema:v1:TaskProfileV1",
  "title": "TaskProfileV1",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "record_id",
    "task_id",
    "sport",
    "prediction_unit",
    "scorer",
    "sample_ids"
  ],
  "properties": {
    "schema_name": { "const": "TaskProfileV1" },
    "schema_version": { "const": "1.0.0" },
    "record_id": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/recordId" },
    "task_id": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/recordId" },
    "sport": { "type": "string", "minLength": 1, "maxLength": 80 },
    "prediction_unit": {
      "enum": ["rally_boundary", "rally_outcome", "shot_boundary", "coach_instruction"]
    },
    "boundary_tolerance_frames": { "type": "integer", "minimum": 0 },
    "scorer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "type": "string", "minLength": 1, "maxLength": 80 },
        "digest": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "sample_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/recordId" }
    },
    "frozen_at": { "type": "string", "format": "date-time" },
    "notes": { "type": "string", "maxLength": 2000 }
  },
  "allOf": [
    {
      "if": { "properties": { "prediction_unit": { "const": "rally_boundary" } } },
      "then": { "required": ["boundary_tolerance_frames"] }
    }
  ],
  "additionalProperties": false
}
