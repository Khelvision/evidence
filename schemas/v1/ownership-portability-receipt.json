{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:khelsutra:evidence:schema:v1:OwnershipPortabilityReceiptV1",
  "title": "OwnershipPortabilityReceiptV1",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "record_id",
    "receipt_id",
    "package_id",
    "export",
    "restore",
    "reproduction",
    "promotion",
    "rollback",
    "vendor_account_required",
    "second_environment"
  ],
  "properties": {
    "schema_name": { "const": "OwnershipPortabilityReceiptV1" },
    "schema_version": { "const": "1.0.0" },
    "record_id": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/recordId" },
    "receipt_id": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/recordId" },
    "package_id": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/recordId" },
    "export": { "$ref": "#/$defs/operation" },
    "restore": { "$ref": "#/$defs/operation" },
    "reproduction": {
      "type": "object",
      "required": ["attempted", "passed", "sample_count", "tolerance", "max_observed_delta"],
      "properties": {
        "attempted": { "const": true },
        "passed": { "type": "boolean" },
        "sample_count": { "type": "integer", "minimum": 1 },
        "tolerance": { "type": "number", "minimum": 0 },
        "max_observed_delta": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "promotion": { "$ref": "#/$defs/operation" },
    "rollback": { "$ref": "#/$defs/operation" },
    "vendor_account_required": { "type": "boolean" },
    "second_environment": {
      "type": "object",
      "required": ["runtime", "provider_class", "clean_environment"],
      "properties": {
        "runtime": { "type": "string", "minLength": 1, "maxLength": 160 },
        "provider_class": { "enum": ["local", "owner_cloud", "independent_provider"] },
        "clean_environment": { "const": true }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "required": ["attempted", "passed", "artifact_refs"],
      "properties": {
        "attempted": { "const": true },
        "passed": { "type": "boolean" },
        "artifact_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/artifactRef" }
        },
        "notes": { "type": "string", "maxLength": 1000 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
