{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:khelsutra:evidence:schema:v1:CoachInstructionPlanV1",
  "title": "CoachInstructionPlanV1",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "record_id",
    "plan_id",
    "actor_role",
    "workspace_id",
    "instruction",
    "scope",
    "filters",
    "transformations",
    "output",
    "ambiguities",
    "human_decision_authority"
  ],
  "properties": {
    "schema_name": { "const": "CoachInstructionPlanV1" },
    "schema_version": { "const": "1.0.0" },
    "record_id": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/recordId" },
    "plan_id": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/recordId" },
    "actor_role": { "enum": ["coach", "self_coach"] },
    "workspace_id": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/recordId" },
    "instruction": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "scope": {
      "type": "object",
      "required": ["player_ref", "completed_matches", "order", "timezone"],
      "properties": {
        "player_ref": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/recordId" },
        "completed_matches": { "type": "integer", "minimum": 1 },
        "order": { "const": "recorded_at_desc" },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 80 }
      },
      "additionalProperties": false
    },
    "filters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["field", "operator", "value", "accepted_authorities"],
        "properties": {
          "field": { "type": "string", "minLength": 1, "maxLength": 120 },
          "operator": { "enum": ["equals", "in", "gte", "lte"] },
          "value": {},
          "accepted_authorities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "urn:khelsutra:evidence:schema:v1:common#/$defs/authority" }
          }
        },
        "additionalProperties": false
      }
    },
    "transformations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["operation"],
        "properties": {
          "operation": { "enum": ["keep_last_shots", "order_chronologically", "stitch"] },
          "count": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "output": {
      "type": "object",
      "required": ["kind", "rendition", "include_provenance", "include_omissions"],
      "properties": {
        "kind": { "const": "video_reel" },
        "rendition": { "type": "string", "minLength": 1, "maxLength": 80 },
        "include_provenance": { "const": true },
        "include_omissions": { "const": true }
      },
      "additionalProperties": false
    },
    "ambiguities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "human_decision_authority": { "const": true }
  },
  "additionalProperties": false
}
